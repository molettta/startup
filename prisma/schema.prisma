// ============================================================================
// SCHEMA DO PRISMA
//
// Este arquivo é a fonte única da verdade do banco de dados. A partir dele:
//   - `npx prisma migrate dev`  gera o SQL e aplica no banco
//   - `npx prisma generate`     gera o client TypeScript já tipado
//
// Ou seja: você NÃO escreve SQL e NÃO escreve os tipos das entidades à mão.
// Mudou algo aqui? Rode `npm run db:migrate` para o banco acompanhar.
// ============================================================================

// O generator define o client que o Prisma vai gerar para você usar no código.
// A partir do Prisma 7 o `output` é obrigatório: o client é gerado DENTRO do
// projeto (e não escondido em node_modules), em src/generated/prisma.
// Esse diretório está no .gitignore de propósito — é código gerado, e quem
// clonar o repositório o recria com `npx prisma generate`.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

// O datasource diz qual banco estamos usando.
// Repare que NÃO existe `url` aqui: desde o Prisma 7 a connection string vive
// no prisma.config.ts (para o CLI) e no adapter em src/lib/prisma.ts (para a
// aplicação). Assim a credencial fica só no .env, nunca em arquivo versionado.
datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// User — quem faz login na API.
// ----------------------------------------------------------------------------
model User {
  id Int @id @default(autoincrement())

  name String

  // @unique cria um índice único no banco. É ele que garante, no nível do
  // banco, que não existem dois usuários com o mesmo email — mesmo que dois
  // cadastros cheguem exatamente ao mesmo tempo e passem os dois pela
  // verificação feita no controller.
  email String @unique

  // ATENÇÃO: aqui fica o *hash* da senha, nunca a senha em si.
  // Quem gera o hash é o bcrypt, em src/controllers/user.controller.ts.
  // Um hash bcrypt tem sempre 60 caracteres e começa com "$2b$10$".
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // o Prisma atualiza sozinho a cada update

  // Um usuário tem várias roles e uma role pertence a vários usuários (N:N).
  // Ao declarar `Role[]` dos dois lados com o mesmo nome de relação, o Prisma
  // cria e gerencia sozinho a tabela de junção — aqui, "_UserRoles".
  // Isso se chama *relação many-to-many implícita*.
  roles Role[] @relation("UserRoles")

  // As vistorias que este usuário registrou.
  //
  // REPARE QUE NÃO EXISTE UMA TABELA "Vistoriador". Ser vistoriador é ter a
  // role correspondente, não ser outro tipo de registro — quem responde "o que
  // essa pessoa pode fazer?" é o RBAC, e quem responde "quem fez esta
  // vistoria?" é a chave estrangeira lá no model Vistoria.
  //
  // Uma tabela 1:1 com User só se justifica quando o vistoriador ganhar
  // atributos que SÓ ele tem (matrícula, região de atuação, assinatura). Até
  // lá ela seria uma tabela com uma FK e mais nada: um join a cada consulta e
  // um estado novo para tratar ("tem a role mas não tem a linha") em troca de
  // zero informação. E criá-la depois é barato: nasce com `userId @unique`,
  // sem migrar nenhuma linha existente.
  vistorias Vistoria[] @relation("VistoriasDoVistoriador")
}

// ----------------------------------------------------------------------------
// Role — o "cargo" do usuário (Admin, User...). Agrupa permissões.
// ----------------------------------------------------------------------------
model Role {
  id Int @id @default(autoincrement())

  // @unique aqui não é só uma restrição: ele também permite buscar e conectar
  // roles pelo nome (`where: { name: 'Admin' }`), que é o que o seed faz.
  name String @unique

  users       User[]       @relation("UserRoles")
  permissions Permission[] @relation("RolePermissions")
}

// ----------------------------------------------------------------------------
// Permission — uma ação concreta ("users:list", "users:write").
//
// POR QUE separar Role de Permission?
// Se o código perguntasse "esse usuário é Admin?", cada nova regra viraria um
// `if` novo espalhado pelos controllers, e criar um cargo intermediário
// (um "Moderador", por exemplo) exigiria mexer em todos eles.
// Perguntando "esse usuário tem a permissão users:list?", as rotas ficam
// estáveis: dar ou tirar poder de um cargo vira só mudar o vínculo entre Role
// e Permission — sem tocar em nenhuma rota. Esse desenho é o RBAC
// (Role-Based Access Control).
// ----------------------------------------------------------------------------
model Permission {
  id Int @id @default(autoincrement())

  name String @unique

  roles Role[] @relation("RolePermissions")
}

// ----------------------------------------------------------------------------
// Vistoria — o registro de uma inspeção feita em campo.
//
// Os nomes deste bloco estão em português, diferente de User/Role/Permission,
// porque aqui começa o *domínio* da aplicação: "vistoria" e "vistoriador" são
// os termos que o cliente usa, e traduzi-los só criaria um dicionário a mais
// para consultar ao ler o código.
// ----------------------------------------------------------------------------
model Vistoria {
  id Int @id @default(autoincrement())

  titulo    String
  descricao String?

  // Guardamos o status como texto por enquanto, e não como enum do Prisma.
  // Enum no PostgreSQL é um tipo criado no banco: acrescentar um valor exige
  // migration. Enquanto os status ainda estão sendo descobertos, texto + uma
  // constante no código muda mais rápido. Vale trocar por enum quando a lista
  // parar de mexer — aí o ganho de segurança de tipo compensa.
  status String @default("RASCUNHO") // RASCUNHO | FINALIZADA

  // QUEM FEZ A VISTORIA. É esta FK — e não uma tabela de vistoriador — que
  // responde a pergunta.
  vistoriadorId Int
  vistoriador   User @relation("VistoriasDoVistoriador", fields: [vistoriadorId], references: [id])

  fotos VistoriaFoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice na FK. Sem ele, "as vistorias do usuário X" varre a tabela inteira;
  // com ele, o banco vai direto nas linhas certas. O @unique cria índice
  // sozinho, mas uma FK comum não — é preciso pedir.
  @@index([vistoriadorId])
}

// ----------------------------------------------------------------------------
// VistoriaFoto — uma foto anexada a uma vistoria, com comentário opcional.
// ----------------------------------------------------------------------------
model VistoriaFoto {
  id Int @id @default(autoincrement())

  // O comentário que acompanha a foto ("infiltração no canto direito").
  comentario String?

  // ATENÇÃO: A FOTO EM SI NÃO ESTÁ AQUI.
  //
  // O banco guarda apenas o nome do arquivo salvo em disco (veja
  // src/lib/upload.ts). Gravar o binário numa coluna faria três estragos:
  // o dump de backup passaria a carregar todas as fotos, cada leitura traria
  // a imagem inteira para a memória do servidor, e o navegador perderia a
  // chance de cachear o arquivo. Banco guarda dado; arquivo fica em storage.
  arquivo String

  // Metadados do upload. `contentType` é o que permite devolver o header certo
  // no download; `tamanhoBytes` evita ter que consultar o disco para exibir.
  contentType  String
  tamanhoBytes Int

  // `onDelete: Cascade` manda o BANCO apagar as fotos quando a vistoria some.
  // Sem isso, apagar uma vistoria com fotos falharia por violação de FK — ou,
  // pior, deixaria fotos órfãs apontando para uma vistoria inexistente.
  vistoriaId Int
  vistoria   Vistoria @relation(fields: [vistoriaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([vistoriaId])
}
