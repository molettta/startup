# Copie para .env e ajuste os valores.
#   cp .env.example .env

# --- Postgres (lido pelo docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fweapi
# 5433 para nao conflitar com outro Postgres que ja use a 5432 na sua maquina.
POSTGRES_PORT=5433

# --- Aplicacao ---
# Precisa bater com as variaveis POSTGRES_* acima (inclusive a porta).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fweapi?schema=public"

# Segredo de assinatura dos tokens JWT. Em producao use um valor aleatorio longo:
#   openssl rand -base64 32
JWT_SECRET="troque-esse-valor-por-um-segredo-aleatorio"

JWT_EXPIRES_IN="1h"
PORT=3000
